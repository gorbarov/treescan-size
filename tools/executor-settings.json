{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(swift build *)",
      "Bash(swift run *)",
      "Bash(swift package *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(python3 tools/*)",
      "Bash(tools/make_fixture.sh *)",
      "Bash(.build/release/*)",
      "Bash(scripts/*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(time *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(chmod +x *)",
      "Bash(codesign *)",
      "Bash(sips *)",
      "Bash(iconutil *)",
      "Bash(plutil *)",
      "Bash(echo *)",
      "Bash(touch *)",
      "Bash(find *)",
      "Bash(sed -n *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(python3 -c *)",
      "Bash(swift --version)",
      "Bash(tools/check_task.sh *)",
      "Bash(/tmp/ts-build/*)",
      "Bash(swift scripts/*)",
      "Bash(build/TreeSize.app/*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(trash *)",
      "Bash(xattr *)",
      "Bash(osascript *)",
      "Bash(mv *)",
      "Bash(open *)",
      "Bash(curl *)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(sudo *)",
      "WebFetch",
      "WebSearch",
      "Edit(../../**)",
      "Write(../../**)",
      "Edit(tools/**)",
      "Write(tools/**)",
      "Edit(docs/tasks/**)",
      "Write(docs/tasks/**)",
      "Edit(docs/UI-SPEC.md)",
      "Edit(AGENTS.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "/tmp/ts-fixture",
        "/private/tmp/ts-fixture",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm",
        "~/.swiftpm",
        "~/Library/Developer/Xcode/DerivedData/ModuleCache.noindex",
        "~/Library/Caches/clang",
        "/tmp/ts-build",
        "/private/tmp/ts-build"
      ]
    }
  }
}